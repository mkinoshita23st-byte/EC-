<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="https://jakarta.ee/xml/ns/jakartaee"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
	id="WebApp_ID" version="5.0">
	<display-name>WebBookStore_ver2.0</display-name>
	<context-param>
		<param-name>book.title</param-name>
		<param-value>BookStore</param-value>
	</context-param>
	<context-param>
		<param-name>smtp.host</param-name>
		<param-value>localhost</param-value>
	</context-param>
	<context-param>
		<param-name>smtp.port</param-name>
		<param-value>25</param-value>
	</context-param>
	<context-param>
		<param-name>smtp.user</param-name>
		<param-value>xxxxx</param-value>
	</context-param>
	<context-param>
		<param-name>smtp.password</param-name>
		<param-value>xxxxx</param-value>
	</context-param>
	<context-param>
		<param-name>smtp.charset</param-name>
		<param-value>UTF-8</param-value>
	</context-param>
	<!-- フィルター -->
	<filter>
		<filter-name>AuthFilter</filter-name>
		<filter-class>Filter.AuthFilter</filter-class>
		<init-param>
			<param-name>path</param-name>
			<param-value>/WEB-INF/data</param-value>
		</init-param>
	</filter>
	<filter-mapping>
		<filter-name>AuthFilter</filter-name>
		<url-pattern>/*</url-pattern>
		<dispatcher>REQUEST</dispatcher>
	</filter-mapping>
	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
		<welcome-file>index.jsp</welcome-file>
		<welcome-file>index.htm</welcome-file>
		<welcome-file>index.xhtml</welcome-file>
		<welcome-file>default.html</welcome-file>
		<welcome-file>default.jsp</welcome-file>
		<welcome-file>default.htm</welcome-file>
		<welcome-file>default.xhtml</welcome-file>
	</welcome-file-list>
</web-app>